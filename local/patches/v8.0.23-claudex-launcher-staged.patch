+package main
+
+import (
+	"bytes"
+	"os"
+	"path/filepath"
+	"strings"
+	"testing"
+)
+
+func TestRunReadsClientKey(t *testing.T) {
+	file := filepath.Join(t.TempDir(), "proxy.yaml")
+	if err := os.WriteFile(file, []byte("access: {api-keys: [test-only-client-key]}\n"), 0600); err != nil {
+		t.Fatal(err)
+	}
+	var stdout, stderr bytes.Buffer
+	if status := run([]string{"--config", file}, &stdout, &stderr); status != 0 {
+		t.Fatalf("status=%d stderr=%q", status, stderr.String())
+	}
+	if stdout.String() != "test-only-client-key\n" || stderr.Len() != 0 {
+		t.Fatalf("unexpected result stdout=%q stderr=%q", stdout.String(), stderr.String())
+	}
+}
+
+func TestRunErrorsDoNotDiscloseConfig(t *testing.T) {
+	file := filepath.Join(t.TempDir(), "proxy.yaml")
+	if err := os.WriteFile(file, []byte("access: {api-keys: secret-value}\n"), 0600); err != nil {
+		t.Fatal(err)
+	}
+	for _, args := range [][]string{{}, {"--config"}, {"--config", file, "extra"}, {"--config", file}, {"--config", file + ".absent"}} {
+		var stdout, stderr bytes.Buffer
+		if status := run(args, &stdout, &stderr); status == 0 {
+			t.Fatalf("invalid call succeeded: %v", args)
+		}
+		if stdout.Len() != 0 || strings.Contains(stderr.String(), "secret-value") || stderr.Len() == 0 {
+			t.Fatal("failure must be nonempty, sanitized, and on stderr only")
+		}
+	}
+}

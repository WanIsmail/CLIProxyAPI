+package claudexconfig
+
+import (
+	"errors"
+	"io"
+	"strings"
+
+	"gopkg.in/yaml.v3"
+)
+
+// ReadClientKey selects a local client key, never an upstream provider key.
+// A present v8 field takes precedence even when it is empty or invalid.
+func ReadClientKey(reader io.Reader) (string, error) {
+	decoder := yaml.NewDecoder(reader)
+	var config map[string]any
+	if err := decoder.Decode(&config); err != nil {
+		return "", errors.New("invalid YAML configuration")
+	}
+	var extra any
+	if err := decoder.Decode(&extra); err != io.EOF {
+		return "", errors.New("configuration must contain exactly one YAML document")
+	}
+	keys, exists := config["api-keys"]
+	if rawAccess, hasAccess := config["access"]; hasAccess {
+		access, valid := rawAccess.(map[string]any)
+		if !valid {
+			return "", errors.New("access configuration must be a mapping")
+		}
+		if currentKeys, present := access["api-keys"]; present {
+			keys, exists = currentKeys, true
+		}
+	}
+	list, valid := keys.([]any)
+	if !exists || !valid {
+		return "", errors.New("client API keys must be a string list")
+	}
+	first := ""
+	for _, raw := range list {
+		key, valid := raw.(string)
+		if !valid {
+			return "", errors.New("client API keys must contain only strings")
+		}
+		if strings.IndexFunc(key, func(r rune) bool { return r < 0x20 || r == 0x7f }) >= 0 {
+			return "", errors.New("client API keys must not contain control characters")
+		}
+		key = strings.TrimSpace(key)
+		if first == "" && key != "" {
+			first = key
+		}
+	}
+	if first == "" {
+		return "", errors.New("no nonempty client API key is configured")
+	}
+	return first, nil
+}

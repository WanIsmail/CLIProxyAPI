+import assert from 'node:assert/strict';
+import { spawnSync } from 'node:child_process';
+import fs from 'node:fs';
+import path from 'node:path';
+import { fileURLToPath } from 'node:url';
+import test from 'node:test';
+
+const root = path.resolve(path.dirname(fileURLToPath(import.meta.url)), '..');
+
+function launch(config) {
+  const scratch = fs.mkdtempSync(path.join(root, 'tmp', 'config-layout-test.'));
+  try {
+    const filename = path.join(scratch, 'config.yaml');
+    fs.writeFileSync(filename, config, { mode: 0o600 });
+    // Only the external service/client boundaries are replaced. Config parsing,
+    // key selection, discovery filtering, and launcher arguments remain real.
+    const result = spawnSync('bash', [path.join(root, 'claude-codex'), '--continue'], {
+      encoding: 'utf8',
+      env: {
+        ...process.env,
+        PATH: path.join(root, 'tests', 'fixtures', 'bin') + ':' + process.env.PATH,
+        CLIPROXY_CONFIG: filename,
+        CLAUDEX_GATEWAY_CACHE: path.join(scratch, 'cache.json'),
+        CLIPROXY_TEST_EXPECTED_CLIENT_KEY: 'test-only-client-key',
+        CLIPROXY_TEST_SYSTEMCTL_LOG: path.join(scratch, 'service.log'),
+      },
+    });
+    return {
+      ...result,
+      cacheExists: fs.existsSync(path.join(scratch, 'cache.json')),
+      serviceTouched: fs.existsSync(path.join(scratch, 'service.log')),
+    };
+  } finally {
+    fs.rmSync(scratch, { recursive: true });
+  }
+}
+
+test('launcher accepts the legacy client-key layout without changing compaction', () => {
+  const result = launch('api-keys:\n  - "test-only-client-key"\n');
+  assert.equal(result.status, 0, result.stderr);
+  assert.match(result.stdout, /^arg=200000$/m);
+  assert.match(result.stdout, /^enforce_available_models=true$/m);
+  assert.equal(result.cacheExists, true);
+});
+
+test('launcher accepts the v8 layout without using provider API keys', () => {
+  const result = launch(`access:\n  api-keys: [test-only-client-key]\napi-keys:\n  codex:\n    - name: upstream\n      keys:\n        - api-key: test-only-provider-key\n`);
+  assert.equal(result.status, 0, result.stderr);
+  assert.match(result.stdout, /^arg=200000$/m);
+  assert.match(result.stdout, /^enforce_available_models=true$/m);
+  assert.equal(result.cacheExists, true);
+});
+
+test('launcher fails before service startup when a present v8 field is empty', () => {
+  const result = launch('access: {api-keys: []}\napi-keys:\n  - "test-only-client-key"\n');
+  assert.notEqual(result.status, 0);
+  assert.equal(result.serviceTouched, false);
+  assert.equal(result.cacheExists, false);
+  assert.doesNotMatch(result.stdout + result.stderr, /test-only-client-key/);
+});
+
+test('launcher prefers a present v8 client key over a stale legacy key', () => {
+  const result = launch('access: {api-keys: [test-only-client-key]}\napi-keys:\n  - "test-only-stale-client-key"\n');
+  assert.equal(result.status, 0, result.stderr);
+  assert.equal(result.cacheExists, true);
+});
+
+test('launcher fails closed on malformed YAML without echoing configuration', () => {
+  const result = launch('api-keys: [test-only-client-key\n');
+  assert.notEqual(result.status, 0);
+  assert.equal(result.serviceTouched, false);
+  assert.doesNotMatch(result.stdout + result.stderr, /test-only-client-key/);
+});

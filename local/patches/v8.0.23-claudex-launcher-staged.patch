+package main
+
+import (
+	"fmt"
+	"io"
+	"os"
+
+	"claudex.local/gateway/internal/claudexconfig"
+)
+
+func run(args []string, stdout, stderr io.Writer) int {
+	if len(args) != 2 || args[0] != "--config" {
+		_, _ = fmt.Fprintln(stderr, "usage: claudex-config --config PATH")
+		return 2
+	}
+	file, err := os.Open(args[1])
+	if err != nil {
+		_, _ = fmt.Fprintln(stderr, "Claudex configuration is not readable")
+		return 1
+	}
+	key, err := claudexconfig.ReadClientKey(file)
+	errClose := file.Close()
+	if err != nil {
+		_, _ = fmt.Fprintln(stderr, "Claudex configuration:", err)
+		return 1
+	}
+	if errClose != nil {
+		_, _ = fmt.Fprintln(stderr, "Could not close Claudex configuration")
+		return 1
+	}
+	if _, err := fmt.Fprintln(stdout, key); err != nil {
+		_, _ = fmt.Fprintln(stderr, "Could not deliver the configured client key")
+		return 1
+	}
+	return 0
+}
+
+func main() {
+	os.Exit(run(os.Args[1:], os.Stdout, os.Stderr))
+}

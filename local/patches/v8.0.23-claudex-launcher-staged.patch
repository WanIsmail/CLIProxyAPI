+package claudexconfig
+
+import (
+	"strings"
+	"testing"
+)
+
+func TestReadClientKey(t *testing.T) {
+	for _, tc := range []struct {
+		name string
+		yaml string
+		want string
+	}{
+		{"legacy block", "api-keys:\n  - \"client-legacy\"\n", "client-legacy"},
+		{"legacy flow", "api-keys: [client-first, client-second]\n", "client-first"},
+		{"legacy single quoted", "api-keys: ['client-legacy']\n", "client-legacy"},
+		{"quoted YAML key", "\"api-keys\": [client-legacy]\n", "client-legacy"},
+		{"v8 block", "access:\n  api-keys:\n    - \"client-v8\"\n", "client-v8"},
+		{"v8 flow", "access: {api-keys: [client-v8]}\n", "client-v8"},
+		{"v8 precedence", "access: {api-keys: [client-v8]}\napi-keys: [client-legacy]\n", "client-v8"},
+		{"v8 provider isolation", "access: {api-keys: [client-v8]}\napi-keys: {codex: [{keys: [{api-key: provider-secret}]}]}\n", "client-v8"},
+		{"access without key retains legacy", "access: {other: true}\napi-keys: [client-legacy]\n", "client-legacy"},
+		{"blank keys normalized", "access: {api-keys: ['', '  ', ' client-v8 ']}\n", "client-v8"},
+		{"YAML comments", "# api-keys: [not-the-key]\naccess: {api-keys: [client-v8]} # comment\n", "client-v8"},
+		{"quoted hash", "access: {api-keys: ['client#key']}\n", "client#key"},
+		{"literal shell syntax", "api-keys: ['$(touch /should-not-exist)']\n", "$(touch /should-not-exist)"},
+		{"YAML alias", "clients: &clients [client-v8]\naccess: {api-keys: *clients}\n", "client-v8"},
+	} {
+		t.Run(tc.name, func(t *testing.T) {
+			got, err := ReadClientKey(strings.NewReader(tc.yaml))
+			if err != nil {
+				t.Fatal(err)
+			}
+			if got != tc.want {
+				t.Errorf("key = %q, want %q", got, tc.want)
+			}
+		})
+	}
+}
+
+func TestReadClientKeyRejectsUnsafeConfiguration(t *testing.T) {
+	for _, tc := range []struct {
+		name string
+		yaml string
+	}{
+		{"no keys", "host: 127.0.0.1\n"},
+		{"empty document", ""},
+		{"empty legacy list", "api-keys: []\n"},
+		{"null legacy list", "api-keys: null\n"},
+		{"provider groups only", "api-keys: {codex: [{keys: [{api-key: provider-secret}]}]}\n"},
+		{"empty v8 blocks fallback", "access: {api-keys: []}\napi-keys: [legacy-secret]\n"},
+		{"null v8 blocks fallback", "access: {api-keys: null}\napi-keys: [legacy-secret]\n"},
+		{"scalar v8 blocks fallback", "access: {api-keys: client-secret}\napi-keys: [legacy-secret]\n"},
+		{"malformed access blocks fallback", "access: client-secret\napi-keys: [legacy-secret]\n"},
+		{"null access blocks fallback", "access: null\napi-keys: [legacy-secret]\n"},
+		{"empty keys", "api-keys: ['', '  ']\n"},
+		{"non-string key", "api-keys: [true]\n"},
+		{"invalid later key", "api-keys: [client-secret, {}]\n"},
+		{"header injection", "api-keys: [\"client-secret\\r\\nX-Injected: yes\"]\n"},
+		{"NUL key", "api-keys: [\"client-secret\\0\"]\n"},
+		{"duplicate YAML keys", "api-keys: [client-secret]\napi-keys: [legacy-secret]\n"},
+		{"malformed YAML", "api-keys: [client-secret\n"},
+		{"multiple YAML documents", "api-keys: [client-secret]\n---\naccess: {api-keys: [legacy-secret]}\n"},
+	} {
+		t.Run(tc.name, func(t *testing.T) {
+			got, err := ReadClientKey(strings.NewReader(tc.yaml))
+			if err == nil || got != "" {
+				t.Fatalf("unsafe config accepted: nonempty key=%t error=%v", got != "", err)
+			}
+			if strings.Contains(err.Error(), "secret") {
+				t.Fatal("diagnostic leaked configuration values")
+			}
+		})
+	}
+}

+#!/usr/bin/env python3
+"""Offline checks for native task reminders and their wrapper-only wiring."""
+
+import json
+from pathlib import Path
+import subprocess
+import unittest
+
+ROOT = Path(__file__).resolve().parents[1]
+HOOK = ROOT / "hooks/native-task-reminder.sh"
+SETTINGS = ROOT / "claudex-settings.json"
+
+
+class NativeTaskReminderTests(unittest.TestCase):
+    def run_hook(self, payload):
+        self.assertTrue(HOOK.is_file(), "native task reminder helper is missing")
+        result = subprocess.run(
+            ["bash", str(HOOK)], input=payload, text=True,
+            capture_output=True, timeout=5, check=False,
+        )
+        self.assertEqual(result.returncode, 0, result.stderr)
+        self.assertEqual(result.stderr, "")
+        return json.loads(result.stdout)
+
+    def test_lifecycle_events_emit_only_event_correct_context(self):
+        events = [("SessionStart", source) for source in
+                  ("startup", "resume", "compact", "clear", "fork")]
+        events.append(("UserPromptSubmit", None))
+        for event, source in events:
+            with self.subTest(event=event, source=source):
+                payload = {"hook_event_name": event, "source": source,
+                           "prompt": "UNTRUSTED_PROMPT_SENTINEL",
+                           "transcript_path": "/do-not-read/transcript.jsonl"}
+                output = self.run_hook(json.dumps(payload))
+                self.assertEqual(set(output), {"hookSpecificOutput"})
+                specific = output["hookSpecificOutput"]
+                self.assertEqual(set(specific), {"hookEventName", "additionalContext"})
+                self.assertEqual(specific["hookEventName"], event)
+                context = specific["additionalContext"]
+                for required in ("TaskList", "TaskCreate", "TaskUpdate", "in_progress",
+                                 "verification", "resume", "compaction", "restrictions"):
+                    self.assertIn(required, context)
+                self.assertNotIn("UNTRUSTED_PROMPT_SENTINEL", context)
+                self.assertNotIn("/do-not-read/", context)
+
+    def test_malformed_or_unsupported_events_are_nonblocking(self):
+        for payload in ("", "{broken", "null", "[]", '"SessionStart"', "{}",
+                        '{"hook_event_name":null}',
+                        '{"hook_event_name":"Stop"}',
+                        '{"hook_event_name":"PreToolUse"}',
+                        '{"hook_event_name":"SessionStart"}\n{}'):
+            with self.subTest(payload=payload):
+                self.assertEqual(self.run_hook(payload), {})
+
+    def test_wrapper_settings_keep_guard_and_register_reminders(self):
+        settings = json.loads(SETTINGS.read_text())
+        self.assertEqual(settings["statusLine"], {
+            "type": "command", "command": "/home/gr33nl4dy/.local/bin/statusline",
+            "refreshInterval": 5,
+        })
+        hooks = settings["hooks"]
+        self.assertNotIn("Stop", hooks)
+        self.assertTrue(any(
+            entry.get("matcher") == "Read" and any(
+                Path(hook["command"]).resolve() == ROOT / "hooks/guard-agent-output.sh"
+                for hook in entry["hooks"])
+            for entry in hooks["PreToolUse"]
+        ))
+        for event in ("SessionStart", "UserPromptSubmit"):
+            with self.subTest(event=event):
+                self.assertIn(event, hooks)
+                reminders = [hook for entry in hooks[event] for hook in entry["hooks"]
+                             if Path(hook["command"]).resolve() == HOOK]
+                self.assertEqual(len(reminders), 1)
+                self.assertEqual(reminders[0]["type"], "command")
+                self.assertLessEqual(reminders[0]["timeout"], 5)
+                self.assertFalse(reminders[0].get("async", False))
+
+    def test_context_preserves_existing_rules_and_native_lifecycle(self):
+        prompt = (ROOT / "claudex-context.md").read_text()
+        for required in ("# Claudex Context Preservation",
+                         "Commands run, test results, and unresolved failures.",
+                         "Never call the deprecated `TaskOutput` tool.",
+                         "agent completion notification", "TaskList", "TaskGet",
+                         "TaskCreate", "TaskUpdate", "in_progress", "verification",
+                         "resume", "compaction", "restrictions"):
+            with self.subTest(required=required):
+                self.assertIn(required, prompt)
+
+
+if __name__ == "__main__":
+    unittest.main(verbosity=2)

+++ b/runtime/hooks/native-task-reminder.sh
@@ -0,0 +1,17 @@
+#!/usr/bin/env bash
+set -euo pipefail
+
+# Stateless context only: native tools, never this hook, own task state.
+output="$(jq -cs '
+  if length != 1 or (.[0] | type) != "object" then {}
+  else
+    .[0].hook_event_name as $event
+    | if $event == "SessionStart" or $event == "UserPromptSubmit" then
+        {hookSpecificOutput: {
+          hookEventName: $event,
+          additionalContext: "For every Claudex work request, use TaskList before substantive work to reconcile the native task list; use TaskGet for details and TaskCreate only for missing work. Use TaskUpdate to mark current work in_progress, keep progress and blockers current, and mark completed only after verification. After changes and before handing back, refresh and display the full list. On resume or compaction, continue existing task IDs instead of duplicating them. Respect explicit tool restrictions: if native tools are unavailable, disclose that and label any temporary text checklist as a fallback, never as a native update. Do not write task storage directly or force unrelated sessions into one list. This reminder creates no tasks and authorizes no additional work, file writes, commits, restarts, or compaction."
+        }}
+      else {} end
+  end
+' 2>/dev/null)" || output='{}'
+printf '%s\n' "$output"

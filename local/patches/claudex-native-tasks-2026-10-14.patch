diff --git a/runtime/tests/claudex-tab-resume.py b/runtime/tests/claudex-tab-resume.py
new file mode 100644
--- /dev/null
+++ b/runtime/tests/claudex-tab-resume.py
@@ -0,0 +1,259 @@
+#!/usr/bin/env python3
+"""Exercise the real launcher with a fake terminal, Zellij, services and Claude."""
+
+import errno
+import json
+import os
+from pathlib import Path
+import pty
+import select
+import shutil
+import signal
+import subprocess
+import tempfile
+import time
+from types import SimpleNamespace
+import unittest
+
+ROOT = Path(__file__).resolve().parents[1]
+LAUNCHER = ROOT / "claude-codex"
+FIXTURES = ROOT / "tests/fixtures/bin"
+PROMPT = b"? [y/N] "
+
+
+def pane(name="own-tab", pane_id=7, plugin=False, focused=False):
+    return {"id": pane_id, "is_plugin": plugin, "tab_name": name,
+            "is_focused": focused}
+
+
+class TabResumeTests(unittest.TestCase):
+    def setUp(self):
+        (ROOT / "tmp").mkdir(exist_ok=True)
+        self.temp = tempfile.TemporaryDirectory(prefix="claudex-tab-test.", dir=ROOT / "tmp")
+        self.addCleanup(self.temp.cleanup)
+        self.work = Path(self.temp.name)
+        self.bin = self.work / "bin"
+        self.bin.mkdir()
+        # An allowlisted PATH prevents fallback to the real Claude/Zellij/services.
+        for command in ("bash", "dirname", "tr", "jq", "sed", "head", "tail",
+                        "mkdir", "mktemp", "date", "chmod", "mv", "unlink",
+                        "timeout", "sleep"):
+            executable = shutil.which(command, path="/usr/bin:/bin")
+            self.assertIsNotNone(executable, f"test dependency missing: {command}")
+            (self.bin / command).symlink_to(executable)
+        for command in ("claude", "curl", "systemctl", "tput", "zellij"):
+            (self.bin / command).symlink_to(FIXTURES / command)
+        config = self.work / "config.yaml"
+        config.write_text('api-keys:\n  - "fixture-only-not-a-credential"\n')
+        self.env = {
+            "PATH": str(self.bin), "HOME": str(self.work / "home"),
+            "CLAUDE_CONFIG_DIR": str(self.work / "claude"),
+            "CLIPROXY_CONFIG": str(config),
+            "CLAUDEX_GATEWAY_CACHE": str(self.work / "gateway-cache.json"),
+            "TERM": "xterm-256color", "LC_ALL": "C.UTF-8",
+            "ZELLIJ": "0", "ZELLIJ_PANE_ID": "7",
+            "CLIPROXY_TEST_ZELLIJ_JSON": json.dumps([
+                pane("focused-other-tab", 8, focused=True),
+                pane("plugin-collision", 7, plugin=True), pane(),
+            ]),
+        }
+        self.run_number = 0
+
+    def launch(self, args=(), *, expect_prompt=False, reply=b"y\n", env=None,
+               terminal=True, redirect=None, expected_lookups=None):
+        self.run_number += 1
+        prefix = self.work / str(self.run_number)
+        args_file = prefix.with_suffix(".args")
+        claude_log = prefix.with_suffix(".claude")
+        zellij_log = prefix.with_suffix(".zellij")
+        services_log = prefix.with_suffix(".services")
+        child_env = dict(self.env, **(env or {}))
+        child_env.update({
+            "CLIPROXY_TEST_CLAUDE_ARGS_FILE": str(args_file),
+            "CLIPROXY_TEST_CLAUDE_LOG": str(claude_log),
+            "CLIPROXY_TEST_ZELLIJ_LOG": str(zellij_log),
+            "CLIPROXY_TEST_SYSTEMCTL_LOG": str(services_log),
+        })
+        argv = [str(LAUNCHER), *args]
+        if terminal:
+            pid, fd = pty.fork()
+            if pid == 0:
+                try:
+                    os.chdir(self.work)
+                    if redirect is not None:
+                        replacement = os.open(os.devnull, os.O_RDWR)
+                        os.dup2(replacement, redirect)
+                        os.close(replacement)
+                    os.execve(str(LAUNCHER), argv, child_env)
+                except Exception:
+                    os._exit(126)
+            output = bytearray()
+            status = None
+            replied = False
+            deadline = time.monotonic() + 10
+            try:
+                while time.monotonic() < deadline:
+                    ready, _, _ = select.select([fd], [], [], 0.1)
+                    if ready:
+                        try:
+                            chunk = os.read(fd, 65536)
+                        except OSError as error:
+                            if error.errno != errno.EIO:
+                                raise
+                            break
+                        if not chunk:
+                            break
+                        output.extend(chunk)
+                        if PROMPT in output and not replied:
+                            self.assertFalse(services_log.exists(),
+                                             "services touched before resume answer")
+                            os.write(fd, reply)
+                            replied = True
+                    if status is None:
+                        finished, child_status = os.waitpid(pid, os.WNOHANG)
+                        if finished:
+                            status = child_status
+                    if status is not None and not ready:
+                        break
+                else:
+                    self.fail("launcher did not finish within the test deadline")
+                if status is None:
+                    _, status = os.waitpid(pid, 0)
+                returncode = os.waitstatus_to_exitcode(status)
+            finally:
+                os.close(fd)
+                if status is None:
+                    try:
+                        os.killpg(pid, signal.SIGKILL)
+                    except ProcessLookupError:
+                        pass
+                    os.waitpid(pid, 0)
+            output = bytes(output)
+        else:
+            result = subprocess.run(argv, input=b"", capture_output=True,
+                                    cwd=self.work, env=child_env, timeout=10, check=False)
+            output = result.stdout + result.stderr
+            returncode = result.returncode
+        self.assertEqual(output.count(PROMPT), int(expect_prompt), output.decode(errors="replace"))
+        actual_args = ([arg.decode() for arg in args_file.read_bytes().split(b"\0")[:-1]]
+                       if args_file.exists() else [])
+        lookups = len(zellij_log.read_text().splitlines()) if zellij_log.exists() else 0
+        calls = len(claude_log.read_text().splitlines()) if claude_log.exists() else 0
+        if expected_lookups is not None:
+            self.assertEqual(lookups, expected_lookups)
+        return SimpleNamespace(returncode=returncode, output=output, args=actual_args,
+                               lookups=lookups, calls=calls)
+
+    def assert_launch(self, result, resume=None, returncode=0):
+        self.assertEqual(result.returncode, returncode, result.output.decode(errors="replace"))
+        self.assertEqual(result.calls, 1)
+        selectors = []
+        for index, argument in enumerate(result.args):
+            if argument.startswith("--resume="):
+                selectors.append(argument.partition("=")[2])
+            elif argument == "--resume":
+                selectors.append(result.args[index + 1])
+        self.assertEqual(selectors, [] if resume is None else [resume])
+        self.assertEqual(result.args.count("--autocompact"), 1)
+        self.assertEqual(result.args.count("900000"), 1)
+
+    def test_yes_resumes_own_pane_not_focus_or_plugin(self):
+        for reply in (b"y\n", b"Y\n", b"yes\n", b"YES\n"):
+            with self.subTest(reply=reply):
+                result = self.launch(expect_prompt=True, reply=reply, expected_lookups=1)
+                self.assertIn(b"Resume session 'own-tab'", result.output)
+                self.assert_launch(result, resume="own-tab")
+
+    def test_no_empty_unrecognized_and_eof_launch_normally(self):
+        for reply in (b"n\n", b"\n", b"no\n", b"maybe\n", b"\x04"):
+            with self.subTest(reply=reply):
+                self.assert_launch(self.launch(expect_prompt=True, reply=reply, expected_lookups=1))
+
+    def test_ctrl_c_cancels_without_starting_services_or_claude(self):
+        result = self.launch(expect_prompt=True, reply=b"\x03", expected_lookups=1)
+        self.assertIn(result.returncode, (-signal.SIGINT, 130))
+        self.assertEqual(result.calls, 0)
+        self.assertEqual(result.args, [])
+        self.assertFalse(list(self.work.glob("*.services")))
+
+    def test_explicit_arguments_never_lookup_or_prompt(self):
+        for args in (("--resume", "chosen session"), ("--resume=chosen session",),
+                     ("-r", "chosen session"), ("-r=chosen session",),
+                     ("--resume",), ("--continue",), ("-c",), ("--help",),
+                     ("--version",), ("-p", "fixture prompt"), ("a prompt",),
+                     ("--model", "claude-gateway-gpt-5-6-sol"),
+                     ("--autocompact", "500000"), ("--",), ("",)):
+            with self.subTest(args=args):
+                result = self.launch(args, expected_lookups=0)
+                self.assertEqual(result.returncode, 0)
+                self.assertEqual(result.calls, 1)
+                self.assertEqual(result.args[-len(args):], list(args))
+
+    def test_outside_zellij_or_invalid_pane_id_skips_lookup(self):
+        for env in ({"ZELLIJ": ""}, {"ZELLIJ_PANE_ID": ""},
+                    {"ZELLIJ_PANE_ID": "terminal_7"}, {"ZELLIJ_PANE_ID": "-1"},
+                    {"ZELLIJ_PANE_ID": "7; printf bad"}):
+            with self.subTest(env=env):
+                self.assert_launch(self.launch(env=env, expected_lookups=0))
+
+    def test_noninteractive_or_redirected_streams_skip_lookup(self):
+        self.assert_launch(self.launch(terminal=False, expected_lookups=0))
+        for redirect in (0, 1, 2):
+            with self.subTest(redirect=redirect):
+                self.assert_launch(self.launch(redirect=redirect, expected_lookups=0))
+
+    def test_missing_zellij_skips_lookup(self):
+        (self.bin / "zellij").unlink()
+        self.assert_launch(self.launch(expected_lookups=0))
+
+    def test_missing_timeout_skips_optional_lookup(self):
+        (self.bin / "timeout").unlink()
+        self.assert_launch(self.launch(expected_lookups=0))
+
+    def test_failed_or_hung_lookup_does_not_block_launch(self):
+        for mode in ("fail", "hang"):
+            with self.subTest(mode=mode):
+                self.assert_launch(self.launch(env={"CLIPROXY_TEST_ZELLIJ_MODE": mode},
+                                               expected_lookups=1))
+
+    def test_malformed_unknown_or_ambiguous_metadata_skips_prompt(self):
+        payloads = ("{broken", "null", "{}", "[]", "[]\n[]",
+                    json.dumps([pane(pane_id=8)]), json.dumps([pane(plugin=True)]),
+                    json.dumps([pane(), pane()]), json.dumps([pane(), pane("other")]),
+                    json.dumps([pane(name=None)]), json.dumps([pane(name=123)]),
+                    json.dumps([pane(name="")]), json.dumps([pane(name="   ")]),
+                    json.dumps([{"id": 7, "tab_name": "missing-plugin-type"}]))
+        for payload in payloads:
+            with self.subTest(payload=payload):
+                self.assert_launch(self.launch(env={"CLIPROXY_TEST_ZELLIJ_JSON": payload},
+                                               expected_lookups=1))
+
+    def test_names_remain_literal_single_values(self):
+        names = ("two words", "Māori-日本語", "  exact spaces  ", "tab'\"name",
+                 "tab;$(touch NOT_EXECUTED)`touch ALSO_NOT_EXECUTED`",
+                 "--model=opus", "100%*[literal]?", "back\\slash")
+        for name in names:
+            with self.subTest(name=name):
+                result = self.launch(expect_prompt=True, expected_lookups=1,
+                                     env={"CLIPROXY_TEST_ZELLIJ_JSON": json.dumps([pane(name)])})
+                self.assert_launch(result, resume=name)
+                # Equals form also keeps a leading dash from becoming another option.
+                self.assertIn("--resume=" + name, result.args)
+                self.assertNotIn("--model", result.args)
+        self.assertFalse((self.work / "NOT_EXECUTED").exists())
+        self.assertFalse((self.work / "ALSO_NOT_EXECUTED").exists())
+
+    def test_control_characters_are_rejected_before_shell_capture(self):
+        for control in ("\n", "\r", "\t", "\x00", "\x1b", "\x7f", "\x85", chr(0x2028), chr(0x202E)):
+            with self.subTest(control=repr(control)):
+                self.assert_launch(self.launch(expected_lookups=1, env={
+                    "CLIPROXY_TEST_ZELLIJ_JSON": json.dumps([pane("tab" + control)])}))
+
+    def test_failed_native_resume_is_not_retried_as_fresh(self):
+        result = self.launch(expect_prompt=True, expected_lookups=1,
+                             env={"CLIPROXY_TEST_CLAUDE_EXIT": "37"})
+        self.assert_launch(result, resume="own-tab", returncode=37)
+
+
+if __name__ == "__main__":
+    unittest.main(verbosity=2)

+		t.Run(host, func(t *testing.T) {
+			req := httptest.NewRequest(http.MethodGet, "/v0/local/codex/account-limits", nil)
+			req.RemoteAddr = "127.0.0.1:4321"
+			req.Host = host
+			rr := httptest.NewRecorder()
+			server.engine.ServeHTTP(rr, req)
